{
  "name": "service-worklog-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Gestão de serviços, agenda e contas para profissionais autônomos",
  "scripts": {
    "dev": "npm run build && concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "vite build --watch",
    "build": "prisma generate && vite build",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests *.ts *.json",
    "format:check": "prettier --check src tests *.ts *.json",
    "test": "node --import tsx --test tests/domain.test.ts",
    "test:integration": "npm run build && node --import tsx --test tests/integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@inertiajs/react": "^3.9.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
